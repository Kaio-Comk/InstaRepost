[Unit]
Description=InstaRepost 24/7 (painel + tunel Cloudflare + auto-post 1/hora)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = sua pasta pessoal. Ajuste se o projeto não estiver em ~/InstaRepost.
WorkingDirectory=%h/InstaRepost
ExecStart=%h/InstaRepost/iniciar_auto.sh
Restart=on-failure
RestartSec=30
# Mantém o serviço de pé; reinicia se a internet/túnel cair.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
