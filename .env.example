# =========================================================
#  InstaRepost — variáveis de ambiente
#  Copie para .env e ajuste. NUNCA versione o .env real.
# =========================================================

# --- Banco de dados ---
# SQLite por padrão (zero-config). Para Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/instarepost
DATABASE_URL=sqlite:///database/instarepost.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Diretórios de trabalho ---
DOWNLOAD_DIR=downloads
DATA_DIR=data

# --- Fonte de ingestão (SourceProvider) ---
# manual       -> lê vídeos de uma pasta (100% compatível com ToS)
# instaloader  -> baixa de um perfil (NÃO-oficial; exige login; use só com autorização)
SOURCE_PROVIDER=manual

# Perfil monitorado (usado por adaptadores remotos)
TARGET_USERNAME=perfil_autorizado

# Pasta observada quando SOURCE_PROVIDER=manual
WATCH_DIR=data/inbox

# --- Login do instaloader (só com SOURCE_PROVIDER=instaloader) ---
# ⚠️ Acesso anônimo é bloqueado (403). É preciso logar com uma conta.
#    Use uma conta DESCARTÁVEL — automação pode resultar em limitação/ban.
# Crie a sessão uma vez importando do Firefox:
#    ./venv/bin/python tools/import_firefox_session.py SEU_USUARIO
INSTALOADER_USER=
INSTALOADER_PASSWORD=
INSTALOADER_MAX_ITEMS=6

# --- Validação de download ---
MAX_VIDEO_MB=300
MIN_VIDEO_MB=0.05
ALLOWED_EXTENSIONS=.mp4,.mov

# --- IA local (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT=120
# Estilo padrão: viral | informativo | profissional | entretenimento
DEFAULT_CAPTION_STYLE=viral

# --- Aprovação ---
# true  = exige aprovação manual no painel antes de publicar.
# false = 100% automático (scheduler baixa, gera legenda e publica sem revisão).
REQUIRE_MANUAL_APPROVAL=true

# --- Publicação ---
# dry_run         -> não publica de verdade (apenas registra). Default seguro.
# instagram_graph -> API oficial (App da Meta). Recomendado.
# instagrapi      -> NÃO-oficial, sem dev portal, publica na sua conta. Risco de ban.
PUBLISHER=dry_run

# Caminho OFICIAL (instagram_graph). Gere com:
#   tools/ig_instagram_setup.py (login por Instagram)  ou  tools/ig_graph_setup.py (login por Facebook)
# Base: graph.instagram.com (login IG) ou graph.facebook.com (login FB).
IG_API_BASE=https://graph.instagram.com/v25.0
IG_USER_ID=
IG_ACCESS_TOKEN=
# URL pública (túnel Cloudflare) apontando para a rota /media do painel.
# Ex.: https://SEU-SUBDOMINIO.trycloudflare.com/media
PUBLIC_MEDIA_BASE_URL=

# Credenciais do publisher NÃO-oficial instagrapi (apenas se PUBLISHER=instagrapi).
# Crie a sessão uma vez com tools/instagrapi_login.py.
INSTAGRAPI_USER=
INSTAGRAPI_PASSWORD=

# --- Scheduler ---
# Intervalo (segundos) entre ciclos.
POLL_INTERVAL_SECONDS=900
# Fila de URLs consumida pelo scheduler no modo instaloader (1 link por linha).
URL_QUEUE_FILE=data/queue.txt

# --- Painel web ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
